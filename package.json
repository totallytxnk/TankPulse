{
  "name": "tankpulse",
  "version": "1.0.0",
  "description": "High-throughput Discord event notification engine for GitHub webhooks — part of the Tank suite",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/bot/register-commands.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "github",
    "webhooks",
    "notifications",
    "bullmq",
    "fastify"
  ],
  "author": "Tank Suite",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.34.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
